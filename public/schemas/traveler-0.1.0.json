{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securejobenvelope.org/schemas/traveler-0.1.0.json",
  "title": "SJE v0.1.0",
  "description": "A traveler. This schema accepts every traveler the reference implementations accept and refuses every traveler they refuse, except for the rules listed in not-expressible-0.1.0.json (rules a JSON Schema cannot state, or could state only by enumerating every case: rules about the wire text, comparisons between members, uniqueness by one member, serialized size). Validate, then apply those rules. Numbers are judged as IEEE-754 binary64 values, string lengths in Unicode code points, patterns as ECMA-262 regular expressions. Shared definitions live in quote-0.1.0.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "traveler_id", "revision", "created_at", "buyer", "part"],
  "properties": {
    "spec": { "const": "sje/0.1.0" },
    "traveler_id": { "$ref": "quote-0.1.0.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "created_at": { "$ref": "quote-0.1.0.json#/$defs/datetime" },
    "buyer": { "$ref": "quote-0.1.0.json#/$defs/org" },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "part_number", "material", "qty"],
      "properties": {
        "family": { "$ref": "quote-0.1.0.json#/$defs/name" },
        "part_number": { "$ref": "quote-0.1.0.json#/$defs/name" },
        "description": { "$ref": "quote-0.1.0.json#/$defs/text" },
        "drawing_rev": { "type": "string", "minLength": 1, "maxLength": 32 },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spec"],
          "properties": {
            "spec": { "$ref": "quote-0.1.0.json#/$defs/name" },
            "form": { "$ref": "quote-0.1.0.json#/$defs/name" },
            "thickness_mm": { "type": "number", "minimum": 0.0001, "maximum": 1000000 }
          }
        },
        "qty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target"],
          "properties": {
            "target": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "breaks": {
              "type": "array",
              "maxItems": 16,
              "items": { "type": "integer", "minimum": 1, "maximum": 1000000 }
            }
          }
        },
        "processes": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 32 }
        },
        "finish": { "$ref": "quote-0.1.0.json#/$defs/text" },
        "tolerances": { "$ref": "quote-0.1.0.json#/$defs/text" },
        "notes": { "$ref": "quote-0.1.0.json#/$defs/text" }
      }
    },
    "need_by": {
      "description": "A calendar day YYYY-MM-DD or a UTC instant (see the datetime definition), or null.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z)?$",
      "allOf": [{ "$ref": "quote-0.1.0.json#/$defs/calendarDate" }]
    },
    "incoterms": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
    "itar": {
      "type": "boolean",
      "description": "Self-declaration of ITAR-controlled technical data. Not access control, not DDTC registration."
    },
    "ship_to": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "line1", "city", "region", "postal", "country"],
      "properties": {
        "name": { "$ref": "quote-0.1.0.json#/$defs/name" },
        "line1": { "$ref": "quote-0.1.0.json#/$defs/line" },
        "line2": { "$ref": "quote-0.1.0.json#/$defs/line" },
        "city": { "$ref": "quote-0.1.0.json#/$defs/name" },
        "region": { "$ref": "quote-0.1.0.json#/$defs/name" },
        "postal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "allOf": [{ "$ref": "quote-0.1.0.json#/$defs/trimmed" }]
        },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "ops": {
      "description": "No two ops share a seq. Not expressible here: see not-expressible-0.1.0.json, rule unique-op-seq.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "code"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "code": { "type": "string", "minLength": 1, "maxLength": 32 },
          "notes": { "$ref": "quote-0.1.0.json#/$defs/text" }
        }
      }
    },
    "quotes": {
      "description": "No two quotes share a quote_id. Not expressible here: see not-expressible-0.1.0.json, rule unique-quote-id.",
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "quote-0.1.0.json" }
    },
    "award": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["quote_id", "awarded_at", "qty"],
      "properties": {
        "quote_id": { "$ref": "quote-0.1.0.json#/$defs/id" },
        "quote_hash": {
          "$ref": "quote-0.1.0.json#/$defs/hash",
          "description": "Content hash of the quote named by quote_id (SHA-384 of its canonical body without its own sig). Part of the signed award body: a signed award must carry it."
        },
        "awarded_at": { "$ref": "quote-0.1.0.json#/$defs/datetime" },
        "qty": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "governing_law": { "$ref": "quote-0.1.0.json#/$defs/name" },
            "warranty": { "$ref": "quote-0.1.0.json#/$defs/text" },
            "payment_terms": { "$ref": "quote-0.1.0.json#/$defs/name" }
          }
        },
        "sig": {
          "$ref": "quote-0.1.0.json#/$defs/signature",
          "description": "Buyer's signature over the award decision and ship_to, bound to this revision (the signed body is the award without this member)."
        }
      }
    },
    "as_built": {
      "anyOf": [{ "$ref": "quote-0.1.0.json#/$defs/freeForm" }, { "type": "null" }]
    },
    "signatures": {
      "description": "Buyer's authorship signature(s) over the quoteable body.",
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "quote-0.1.0.json#/$defs/signature" }
    }
  },
  "$comment": "The ITAR rule below (if itar is true, every quote's seller declares itar: true) names its members with patternProperties, not properties, on purpose. It describes only three members of a traveler; a clean-up pass that deletes whatever a schema's properties do not list (ajv removeAdditional: \"all\") would take a partial properties block as the full list and delete the rest of the document.",
  "if": {
    "required": ["itar"],
    "patternProperties": { "^itar$": { "const": true } }
  },
  "then": {
    "description": "An ITAR traveler carries quotes only from sellers that declare itar: true.",
    "patternProperties": {
      "^quotes$": {
        "items": {
          "patternProperties": {
            "^seller$": {
              "required": ["itar"],
              "patternProperties": { "^itar$": { "const": true } }
            }
          }
        }
      }
    }
  }
}
